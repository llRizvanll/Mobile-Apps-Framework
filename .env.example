# Copy to .env (git-ignored). Expo inlines EXPO_PUBLIC_* at build time — never put secrets here.

# Which brand this build is (a folder in src/brands)
EXPO_PUBLIC_BRAND=main
# development | staging | production (selects the brand's environment overlay)
EXPO_PUBLIC_ENV=development
# mock = in-process fake API (no backend needed) · live = brand API endpoints
EXPO_PUBLIC_API_MODE=mock
# Feature flag overrides for this run (highest precedence), e.g. assistant=off,todos.showCompleted=off
EXPO_PUBLIC_FEATURES=
