{
  "name": "mobile-apps-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Lean React Native (Expo) + TypeScript boilerplate with a built-in framework: clean architecture, feature flags, DI, Redux Toolkit, REST/GraphQL/WebSocket, i18n & RTL, theming, white-label brands, observability and AI tool calling.",
  "keywords": [
    "react-native",
    "react-native-boilerplate",
    "react-native-starter",
    "expo",
    "typescript",
    "clean-architecture",
    "feature-flags",
    "white-label",
    "mvvm",
    "mvi",
    "redux-toolkit"
  ],
  "bugs": {
    "url": "https://github.com/llRizvanll/Mobile-Apps-Framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llRizvanll/Mobile-Apps-Framework.git"
  },
  "author": "llRizvanll",
  "main": "index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm test",
    "bundle:check": "CI=1 expo export --platform ios --output-dir dist",
    "gen:feature": "node scripts/generate-feature.mjs",
    "gen:brand": "node scripts/generate-brand.mjs",
    "flags": "node scripts/feature-flags.mjs",
    "examples:remove": "node scripts/remove-examples.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "expo": "~57.0.25",
    "expo-localization": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-redux": "^9.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
