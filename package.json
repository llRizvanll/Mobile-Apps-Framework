{
  "name": "mobile-app-framework",
  "private": true,
  "version": "0.1.0",
  "description": "White-label, AI-native React Native framework in strict TypeScript: clean architecture, MVVM & MVI, DI, Redux Toolkit, REST/GraphQL/WebSocket, i18n & RTL, design tokens, observability and LLM tool calling.",
  "keywords": [
    "react-native",
    "react-native-framework",
    "react-native-boilerplate",
    "white-label",
    "multi-brand",
    "expo",
    "monorepo",
    "typescript",
    "clean-architecture",
    "mvvm",
    "mvi",
    "dependency-injection",
    "redux-toolkit",
    "graphql",
    "websocket",
    "i18n",
    "rtl",
    "design-tokens",
    "observability",
    "ai",
    "llm",
    "agents"
  ],
  "homepage": "https://llrizvanll.github.io/Mobile-Apps-Framework/",
  "bugs": {
    "url": "https://github.com/llRizvanll/Mobile-Apps-Framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llRizvanll/Mobile-Apps-Framework.git"
  },
  "author": "llRizvanll",
  "workspaces": [
    "packages/*",
    "brands/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm test",
    "gen:feature": "node scripts/generate-feature.mjs",
    "gen:brand": "node scripts/generate-brand.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:dev": "npm run docs:sync && vitepress dev docs",
    "docs:build": "npm run docs:sync && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.9",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-redux": "^9.3.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "zod": "^4.6.5"
  }
}
